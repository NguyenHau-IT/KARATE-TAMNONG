SUPABASE_URL=https://ezpgdvilagzamestcivg.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth (production DB-backed)
AUTH_JWT_SECRET=your_jwt_secret_change_me
AUTH_COOKIE_NAME=karate_auth
AUTH_ACCESS_COOKIE_NAME=karate_auth
AUTH_REFRESH_COOKIE_NAME=karate_refresh
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_MAX_ACTIVE_SESSIONS=5

# Optional: trust reverse proxy (set 1 when deploy behind Nginx/Cloudflare/Render/Railway)
APP_TRUST_PROXY=0

# Rate limit (short-term hardening)
RATE_LIMIT_LOGIN_WINDOW_MS=600000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_WINDOW_MS=600000
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_CHECKIN_WINDOW_MS=300000
RATE_LIMIT_CHECKIN_MAX=30

# JWT key rotation (optional)
# AUTH_JWT_ACTIVE_KID=v1
# AUTH_JWT_SECRETS_JSON={"v1":"your_current_secret","v0":"your_old_secret_for_grace_period"}
