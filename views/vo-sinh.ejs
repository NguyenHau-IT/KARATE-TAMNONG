<%- include('partials/header', { title, activePage: 'vo-sinh' }) %>

<div class="container">
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-secondary small fw-semibold mb-1">Karate Tamnong</p>
      <h1 class="h2 mb-2">Quản lý võ sinh</h1>
      <p class="text-secondary mb-0">Theo dõi hồ sơ võ sinh, thông tin liên hệ và bậc đai hiện tại.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/vo-sinh">Làm mới danh sách</a>
  </div>

  <div class="row g-4">
    <div class="col-xl-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="voSinhFormTitle" class="h5 mb-0">Thêm võ sinh mới</h2>
            <button id="cancelVoSinhEditButton" class="btn btn-sm btn-outline-secondary d-none" type="button">
              Tạo mới
            </button>
          </div>

          <form id="voSinhForm">
            <input id="vo_sinh_editing_id" type="hidden" value="" />

            <div class="mb-3">
              <label for="ho_ten" class="form-label">Họ tên võ sinh</label>
              <input
                id="ho_ten"
                name="ho_ten"
                type="text"
                maxlength="100"
                required
                class="form-control"
                placeholder="Ví dụ: Nguyễn Văn A"
              />
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label for="gioi_tinh" class="form-label">Giới tính</label>
                <select id="gioi_tinh" name="gioi_tinh" class="form-select">
                  <option value="">Chọn giới tính</option>
                  <option value="Nam">Nam</option>
                  <option value="Nữ">Nữ</option>
                  <option value="Khác">Khác</option>
                </select>
              </div>
              <div class="col-md-6">
                <label for="nam_sinh" class="form-label">Năm sinh</label>
                <input
                  id="nam_sinh"
                  name="nam_sinh"
                  type="number"
                  min="1900"
                  max="2100"
                  class="form-control"
                  placeholder="Ví dụ: 2012"
                />
              </div>
            </div>

            <div class="mt-3">
              <label for="bac_dai_id" class="form-label">Bậc đai</label>
              <select id="bac_dai_id" name="bac_dai_id" class="form-select">
                <option value="">Chọn bậc đai</option>
                <% bacDaiList.forEach(function(item) { %>
                  <option value="<%= item.id %>"><%= item.ten_bac_dai %></option>
                <% }) %>
              </select>
            </div>

            <div class="mt-3">
              <label for="so_dien_thoai" class="form-label">Số điện thoại</label>
              <input
                id="so_dien_thoai"
                name="so_dien_thoai"
                type="text"
                maxlength="20"
                class="form-control"
                placeholder="Số điện thoại võ sinh"
              />
            </div>

            <div class="mt-3">
              <label for="dia_chi" class="form-label">Địa chỉ</label>
              <textarea
                id="dia_chi"
                name="dia_chi"
                rows="3"
                maxlength="255"
                class="form-control"
                placeholder="Địa chỉ hiện tại"
              ></textarea>
            </div>

            <div class="mt-3">
              <label for="ho_ten_phu_huynh" class="form-label">Họ tên phụ huynh</label>
              <input
                id="ho_ten_phu_huynh"
                name="ho_ten_phu_huynh"
                type="text"
                maxlength="100"
                class="form-control"
                placeholder="Thông tin phụ huynh nếu có"
              />
            </div>

            <div class="mt-3">
              <label for="so_dien_thoai_phu_huynh" class="form-label">Số điện thoại phụ huynh</label>
              <input
                id="so_dien_thoai_phu_huynh"
                name="so_dien_thoai_phu_huynh"
                type="text"
                maxlength="20"
                class="form-control"
                placeholder="Số điện thoại phụ huynh"
              />
            </div>

            <button id="voSinhSubmitButton" class="btn btn-primary w-100 mt-4" type="submit">Thêm võ sinh</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-xl-8">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
            <h2 class="h5 mb-0">Danh sách võ sinh</h2>
            <span id="voSinhCounter" class="badge text-bg-secondary align-self-start align-self-md-auto">
              <%= voSinhList.length %> mục
            </span>
          </div>

          <div id="voSinhEmptyState" class="alert alert-light border mb-3 <%= voSinhList.length ? 'd-none' : '' %>">
            Chưa có dữ liệu trong bảng <code>vo_sinh</code>.
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>ID</th>
                  <th>Họ tên</th>
                  <th>Giới tính</th>
                  <th>Năm sinh</th>
                  <th>Bậc đai</th>
                  <th>Liên hệ</th>
                  <th>Phụ huynh</th>
                  <th>Địa chỉ</th>
                  <th>Cập nhật</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody id="voSinhTableBody">
                <% voSinhList.forEach(function(item) { %>
                  <% const bacDai = bacDaiList.find(function(bd) { return bd.id === item.bac_dai_id; }); %>
                  <tr data-id="<%= item.id %>">
                    <td><%= item.id %></td>
                    <td class="fw-semibold"><%= item.ho_ten %></td>
                    <td><%= item.gioi_tinh || 'Chưa cập nhật' %></td>
                    <td><%= item.nam_sinh || '' %></td>
                    <td><%= bacDai ? bacDai.ten_bac_dai : 'Chưa phân bậc đai' %></td>
                    <td><%= item.so_dien_thoai || 'Chưa có' %></td>
                    <td>
                      <div><%= item.ho_ten_phu_huynh || 'Chưa có' %></div>
                      <div class="text-secondary small"><%= item.so_dien_thoai_phu_huynh || '' %></div>
                    </td>
                    <td><%= item.dia_chi || 'Chưa có' %></td>
                    <td><%= item.ngay_cap_nhat ? new Date(item.ngay_cap_nhat).toLocaleString('vi-VN') : '' %></td>
                    <td>
                      <div class="d-flex flex-wrap gap-2">
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-primary"
                          data-action="edit"
                          data-id="<%= item.id %>"
                        >
                          Sửa
                        </button>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-danger"
                          data-action="delete"
                          data-id="<%= item.id %>"
                        >
                          Xóa
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.__VO_SINH_DATA__ = <%- JSON.stringify(voSinhList) %>;
  window.__BAC_DAI_OPTIONS__ = <%- JSON.stringify(bacDaiList) %>;
  window.__VO_SINH_FLASH__ = <%- JSON.stringify({ message, errorMessage }) %>;
</script>
<script src="/javascripts/vo-sinh.js"></script>
<%- include('partials/footer') %>
