<%- include('partials/header', { title, activePage: 'vang-mat' }) %>

<div class="container">
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-secondary small fw-semibold mb-1">Karate Tamnong</p>
      <h1 class="h2 mb-2">Tab vắng mặt</h1>
      <p class="text-secondary mb-0">Theo dõi danh sách võ sinh vắng có phép và không phép theo từng buổi học.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if (selectedBuoiHocId) { %>
        <a class="btn btn-outline-primary" href="/diem-danh?buoi_hoc_id=<%= selectedBuoiHocId %>">Quay lại điểm danh</a>
      <% } %>
      <a class="btn btn-outline-secondary" href="/vang-mat">Làm mới</a>
    </div>
  </div>

  <% if (message) { %>
    <div class="alert alert-success" role="status" aria-live="polite"><%= message %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert" aria-live="assertive"><%= errorMessage %></div>
  <% } %>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <form method="get" action="/vang-mat" class="row g-3 align-items-end">
        <div class="col-lg-6">
          <label class="form-label" for="buoi_hoc_id">Buổi học</label>
          <select class="form-select" id="buoi_hoc_id" name="buoi_hoc_id" required>
            <option value="">Chọn buổi học</option>
            <% buoiHocList.forEach(function(item) { %>
              <option value="<%= item.id %>" <%= selectedBuoiHocId === item.id ? 'selected' : '' %>>
                #<%= item.id %> - <%= item.lop_vo ? item.lop_vo.ten_lop : ('Lớp #' + item.lop_vo_id) %> - <%= item.ngay_hoc %>
                (<%= item.gio_bat_dau || '--:--' %> - <%= item.gio_ket_thuc || '--:--' %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-3">
          <label class="form-label" for="loai_vang">Loại vắng</label>
          <select class="form-select" id="loai_vang" name="loai_vang">
            <option value="" <%= !filters.loaiVang ? 'selected' : '' %>>Tất cả</option>
            <option value="co_phep" <%= filters.loaiVang === 'co_phep' ? 'selected' : '' %>>Có phép</option>
            <option value="khong_phep" <%= filters.loaiVang === 'khong_phep' ? 'selected' : '' %>>Không phép</option>
          </select>
        </div>
        <div class="col-lg-3">
          <label class="form-label" for="q">Tìm theo tên / ID</label>
          <input class="form-control" id="q" name="q" value="<%= filters.q || '' %>" placeholder="Ví dụ: Nguyễn Văn A" />
        </div>
        <div class="col-12 d-flex gap-2">
          <button class="btn btn-primary" type="submit" aria-label="Lọc danh sách vắng mặt">Lọc</button>
          <% if (selectedBuoiHocId) { %>
            <a class="btn btn-outline-secondary" href="/vang-mat?buoi_hoc_id=<%= selectedBuoiHocId %>" aria-label="Xóa bộ lọc tab vắng mặt theo buổi học hiện tại">Xóa lọc</a>
          <% } else { %>
            <a class="btn btn-outline-secondary" href="/vang-mat" aria-label="Xóa toàn bộ bộ lọc tab vắng mặt">Xóa lọc</a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <% if (selectedBuoiHocId && selectedBuoiHoc) { %>
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Tổng vắng</div><div class="h4 mb-0"><%= summary.tong_vang %></div></div></div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Vắng có phép</div><div class="h4 mb-0"><%= summary.vang_co_phep %></div></div></div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Vắng không phép</div><div class="h4 mb-0"><%= summary.vang_khong_phep %></div></div></div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Danh sách võ sinh vắng mặt theo bộ lọc hiện tại</caption>
            <thead class="table-light">
              <tr>
                <th>Võ sinh</th>
                <th>Loại vắng</th>
                <th>Lý do</th>
                <th>Cập nhật</th>
              </tr>
            </thead>
            <tbody>
              <% if (!vangMatList.length) { %>
                <tr>
                  <td colspan="4" class="text-center text-secondary py-4">Không có dữ liệu vắng mặt theo bộ lọc hiện tại.</td>
                </tr>
              <% } %>
              <% vangMatList.forEach(function(item) { %>
                <tr>
                  <td>
                    <div class="fw-semibold"><%= item.vo_sinh ? item.vo_sinh.ho_ten : ('#' + item.vo_sinh_id) %></div>
                    <div class="small text-secondary">ID: <%= item.vo_sinh_id %></div>
                  </td>
                  <td>
                    <% if (item.loai_vang === 'co_phep') { %>
                      <span class="badge text-bg-warning">Có phép</span>
                    <% } else { %>
                      <span class="badge text-bg-danger">Không phép</span>
                    <% } %>
                  </td>
                  <td><%= item.ly_do || '---' %></td>
                  <td><%= item.ngay_cap_nhat ? new Date(item.ngay_cap_nhat).toLocaleString('vi-VN') : '' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  (function() {
    var filterForm = document.querySelector('form[action="/vang-mat"][method="get"]');

    if (!filterForm) {
      return;
    }

    var keywordInput = filterForm.querySelector('input[name="q"]');
    var loaiVangSelect = filterForm.querySelector('select[name="loai_vang"]');
    var debounceTimer = null;
    var FILTER_DEBOUNCE_MS = 350;

    function clearDebounceTimer() {
      if (!debounceTimer) {
        return;
      }

      window.clearTimeout(debounceTimer);
      debounceTimer = null;
    }

    function submitNow() {
      clearDebounceTimer();

      if (filterForm.requestSubmit) {
        filterForm.requestSubmit();
        return;
      }

      filterForm.submit();
    }

    function scheduleSubmit() {
      clearDebounceTimer();

      debounceTimer = window.setTimeout(function() {
        submitNow();
      }, FILTER_DEBOUNCE_MS);
    }

    filterForm.addEventListener('submit', clearDebounceTimer);

    if (keywordInput) {
      keywordInput.addEventListener('input', scheduleSubmit);
      keywordInput.addEventListener('keydown', function(event) {
        if (event.key !== 'Enter') {
          return;
        }

        event.preventDefault();
        submitNow();
      });
    }

    if (loaiVangSelect) {
      loaiVangSelect.addEventListener('change', scheduleSubmit);
    }
  })();
</script>

<%- include('partials/footer') %>
