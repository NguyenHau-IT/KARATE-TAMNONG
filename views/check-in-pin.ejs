<%- include('partials/header', { title, activePage: 'check-in-pin' }) %>

<div class="container">
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-secondary small fw-semibold mb-1">Karate Tamnong</p>
      <h1 class="h2 mb-2">Check-in bằng PIN</h1>
      <p class="text-secondary mb-0">Võ sinh nhập mã PIN theo buổi học để điểm danh có mặt.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/check-in-pin">Làm mới</a>
  </div>

  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger"><%= errorMessage %></div>
  <% } %>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <form method="get" action="/check-in-pin" class="row g-3 align-items-end">
        <div class="col-lg-8">
          <label class="form-label" for="buoi_hoc_id">Chọn buổi học</label>
          <select class="form-select" id="buoi_hoc_id" name="buoi_hoc_id" required>
            <option value="">Chọn buổi học</option>
            <% buoiHocList.forEach(function(item) { %>
              <option value="<%= item.id %>" <%= selectedBuoiHocId === item.id ? 'selected' : '' %>>
                #<%= item.id %> - <%= item.lop_vo ? item.lop_vo.ten_lop : ('Lớp #' + item.lop_vo_id) %> - <%= item.ngay_hoc %>
                (<%= item.gio_bat_dau || '--:--' %> - <%= item.gio_ket_thuc || '--:--' %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-4 d-grid">
          <button class="btn btn-primary" type="submit">Tải danh sách võ sinh</button>
        </div>
      </form>
    </div>
  </div>

  <% if (selectedBuoiHocId && selectedBuoiHoc) { %>
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Nhập mã PIN</h2>

            <% if (activePin) { %>
              <div class="alert alert-info">
                PIN đang hiệu lực cho buổi này đã được tạo.<br />
                Hết hạn lúc: <strong><%= new Date(activePin.expiresAt).toLocaleTimeString('vi-VN') %></strong>
              </div>
            <% } else { %>
              <div class="alert alert-warning">Buổi học này chưa có PIN hiệu lực. Vui lòng nhờ HLV tạo PIN trong tab Buổi học.</div>
            <% } %>

            <form method="post" action="/check-in-pin" class="vstack gap-3">
              <input type="hidden" name="buoi_hoc_id" value="<%= selectedBuoiHocId %>" />

              <div>
                <label class="form-label" for="vo_sinh_id">Võ sinh</label>
                <select class="form-select" id="vo_sinh_id" name="vo_sinh_id" required>
                  <option value="">Chọn võ sinh</option>
                  <% voSinhOptions.forEach(function(item) { %>
                    <option value="<%= item.vo_sinh_id %>"><%= item.ho_ten || ('Võ sinh #' + item.vo_sinh_id) %> (#<%= item.vo_sinh_id %>)</option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label class="form-label" for="pin_code">Mã PIN</label>
                <input
                  class="form-control"
                  id="pin_code"
                  name="pin_code"
                  maxlength="4"
                  pattern="\d{4}"
                  inputmode="numeric"
                  required
                  placeholder="Nhập mã PIN 4 số"
                />
              </div>

              <button class="btn btn-success" type="submit">Check-in</button>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Gợi ý thao tác</h2>
            <ol class="mb-0 text-secondary">
              <li>Huấn luyện viên vào tab Buổi học để tạo PIN cho buổi hiện tại.</li>
              <li>Võ sinh chọn đúng buổi học và tên mình.</li>
              <li>Nhập mã PIN 6 số và bấm Check-in.</li>
              <li>Nếu PIN hết hạn, yêu cầu HLV tạo lại PIN mới.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
