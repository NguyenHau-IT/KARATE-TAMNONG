<%- include('partials/header', { title, activePage: 'buoi-hoc' }) %>

<div class="container">
  <% const emptyClassSessionCount = (buoiHocList || []).reduce(function(total, item) {
    const memberCount = lopVoMemberCountMap && lopVoMemberCountMap[String(item.lop_vo_id)]
      ? lopVoMemberCountMap[String(item.lop_vo_id)]
      : 0;
    return memberCount > 0 ? total : total + 1;
  }, 0); %>

  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-secondary small fw-semibold mb-1">Karate Tamnong</p>
      <h1 class="h2 mb-2">Quản lý buổi học</h1>
      <p class="text-secondary mb-0">Tạo và theo dõi danh sách buổi học theo lớp võ.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/buoi-hoc">Làm mới danh sách</a>
  </div>

  <% if (emptyClassSessionCount > 0) { %>
    <div class="alert alert-warning d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2" role="status" aria-live="polite">
      <div>
        <strong>Cảnh báo vận hành:</strong> Có <strong><%= emptyClassSessionCount %></strong> buổi học thuộc lớp chưa có võ sinh.
      </div>
      <a class="btn btn-sm btn-outline-dark" href="/lop-vo">Mở quản lý lớp võ</a>
    </div>
  <% } %>

  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger"><%= errorMessage %></div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <h2 class="h5 mb-3">Tạo buổi học</h2>
          <form method="post" action="/buoi-hoc/tao" class="vstack gap-3">
            <div>
              <label class="form-label" for="lop_vo_id">Lớp võ</label>
              <select class="form-select" id="lop_vo_id" name="lop_vo_id" required>
                <option value="">Chọn lớp võ</option>
                <% lopVoList.forEach(function(item) { %>
                  <option value="<%= item.id %>"><%= item.ten_lop %> (#<%= item.id %>)</option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="form-label" for="ngay_hoc">Ngày học</label>
              <input class="form-control" type="date" id="ngay_hoc" name="ngay_hoc" required />
            </div>
            <div class="row g-3">
              <div class="col-6">
                <label class="form-label" for="gio_bat_dau">Giờ bắt đầu</label>
                <input class="form-control" type="time" id="gio_bat_dau" name="gio_bat_dau" />
              </div>
              <div class="col-6">
                <label class="form-label" for="gio_ket_thuc">Giờ kết thúc</label>
                <input class="form-control" type="time" id="gio_ket_thuc" name="gio_ket_thuc" />
              </div>
            </div>
            <div>
              <label class="form-label" for="ghi_chu">Ghi chú</label>
              <textarea class="form-control" id="ghi_chu" name="ghi_chu" rows="3" maxlength="255"></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Tạo buổi học</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Danh sách buổi học</h2>
            <span class="badge text-bg-secondary"><%= buoiHocList.length %> mục</span>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>ID</th>
                  <th>Lớp võ</th>
                  <th>Ngày học</th>
                  <th>Khung giờ</th>
                  <th>Phiên điểm danh</th>
                  <th>Ghi chú</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% if (!buoiHocList.length) { %>
                  <tr>
                    <td colspan="7" class="text-center text-secondary py-4">Chưa có dữ liệu buổi học.</td>
                  </tr>
                <% } %>
                <% buoiHocList.forEach(function(item) { %>
                  <% const attendanceInfo = activeAttendanceMap ? activeAttendanceMap[item.id] : null; %>
                  <% const memberCount = lopVoMemberCountMap && lopVoMemberCountMap[String(item.lop_vo_id)] ? lopVoMemberCountMap[String(item.lop_vo_id)] : 0; %>
                  <tr>
                    <td><%= item.id %></td>
                    <td>
                      <div><%= item.lop_vo ? item.lop_vo.ten_lop : ('#' + item.lop_vo_id) %></div>
                      <div class="small <%= memberCount > 0 ? 'text-secondary' : 'text-warning fw-semibold' %>">
                        <%= memberCount %> võ sinh
                      </div>
                    </td>
                    <td><%= item.ngay_hoc %></td>
                    <td><%= item.gio_bat_dau || '--:--' %> - <%= item.gio_ket_thuc || '--:--' %></td>
                    <td>
                      <% if (memberCount === 0) { %>
                        <div class="small text-warning fw-semibold">Lớp chưa có võ sinh</div>
                      <% } %>
                      <% if (attendanceInfo) { %>
                        <div class="small text-success fw-semibold">Đang hoạt động (QR)</div>
                        <div class="small text-secondary">Hết hạn: <%= new Date(attendanceInfo.expiresAt).toLocaleTimeString('vi-VN') %></div>
                      <% } else { %>
                        <span class="text-secondary">Chưa mở phiên</span>
                      <% } %>
                    </td>
                    <td><%= item.ghi_chu || '---' %></td>
                    <td>
                      <div class="d-flex flex-wrap gap-2">
                        <% if (memberCount > 0) { %>
                          <a class="btn btn-sm btn-primary" href="/buoi-hoc/diem-danh/<%= item.id %>" target="_blank" rel="noopener">
                            Điểm danh
                          </a>
                          <a class="btn btn-sm btn-outline-secondary" href="/diem-danh?buoi_hoc_id=<%= item.id %>">Điểm danh thủ công</a>
                        <% } else { %>
                          <span class="btn btn-sm btn-secondary disabled" aria-disabled="true" title="Lớp chưa có võ sinh">
                            Điểm danh
                          </span>
                          <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true" title="Lớp chưa có võ sinh">
                            Điểm danh thủ công
                          </span>
                        <% } %>
                        <a class="btn btn-sm btn-outline-warning" href="/vang-mat?buoi_hoc_id=<%= item.id %>">Xem vắng mặt</a>
                        <form method="post" action="/buoi-hoc/xoa/<%= item.id %>" onsubmit="return confirm('Xóa buổi học này?');">
                          <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
