<%- include('partials/header', { title, activePage }) %>

<div class="container">
  <div class="p-4 p-lg-5 mb-4 bg-white border rounded-4 shadow-sm">
    <div class="row g-4 align-items-center">
      <div class="col-lg-8">
        <p class="text-uppercase text-secondary small fw-semibold mb-2">Trang quản trị</p>
        <h1 class="display-6 fw-semibold mb-3">Bảng điều khiển quản lý Karate Tamnong</h1>
        <p class="text-secondary mb-0">
          Theo dõi dữ liệu hiện có, truy cập nhanh các khu vực quản trị và nắm tình trạng cập nhật gần nhất.
        </p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a class="btn btn-primary" href="/bac-dai">Đi tới quản lý bậc đai</a>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
        <div>
          <p class="small text-secondary mb-1">Lối tắt vận hành</p>
          <p class="mb-0">Thao tác nhanh theo thứ tự ưu tiên trong ca làm việc.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-sm btn-primary" href="/buoi-hoc">Mở buổi học</a>
          <a class="btn btn-sm btn-outline-primary" href="/diem-danh">Mở điểm danh</a>
          <a class="btn btn-sm btn-outline-secondary" href="/vang-mat">Kiểm tra vắng mặt</a>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-secondary small mb-2">Tổng bậc đai</p>
          <h2 class="display-6 mb-1"><%= stats.totalBacDai %></h2>
          <p class="text-secondary mb-0">Số bản ghi hiện có trong bảng <code>bac_dai</code>.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-secondary small mb-2">Tổng võ sinh</p>
          <h2 class="display-6 mb-1"><%= stats.totalVoSinh %></h2>
          <p class="text-secondary mb-0">Số hồ sơ võ sinh hiện có trong bảng <code>vo_sinh</code>.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-secondary small mb-2">Cập nhật gần nhất</p>
          <h2 class="h4 mb-1">
            <%= stats.latestUpdatedAt ? new Date(stats.latestUpdatedAt).toLocaleDateString('vi-VN') : 'Chưa có' %>
          </h2>
          <p class="text-secondary mb-0">
            <%= stats.latestUpdatedAt ? new Date(stats.latestUpdatedAt).toLocaleTimeString('vi-VN') : 'Chưa có dữ liệu để theo dõi' %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Bậc đai mới nhất</h2>
            <a class="btn btn-sm btn-outline-secondary" href="/bac-dai">Xem tất cả</a>
          </div>

          <% if (!latestBacDai.length) { %>
            <div class="alert alert-light border mb-0">Chưa có dữ liệu bậc đai để hiển thị.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>ID</th>
                    <th>Tên bậc đai</th>
                    <th>Mô tả</th>
                    <th>Ngày tạo</th>
                  </tr>
                </thead>
                <tbody>
                  <% latestBacDai.forEach(function(item) { %>
                    <tr>
                      <td><%= item.id %></td>
                      <td class="fw-semibold"><%= item.ten_bac_dai %></td>
                      <td><%= item.mo_ta || 'Chưa có mô tả' %></td>
                      <td><%= item.ngay_tao ? new Date(item.ngay_tao).toLocaleString('vi-VN') : '' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Truy cập nhanh</h2>
            <span class="badge text-bg-light border text-dark" id="quickLinkCountBadge"><%= quickLinks.length %> mục</span>
          </div>

          <div class="mb-3">
            <label class="form-label small text-secondary mb-1" for="quickLinkSearchInput">Tìm chức năng</label>
            <input
              type="search"
              id="quickLinkSearchInput"
              class="form-control"
              placeholder="Ví dụ: điểm danh, lớp võ, vắng mặt..."
              autocomplete="off"
            />
          </div>
          <p id="quickLinkSearchSummary" class="small text-secondary mb-3" aria-live="polite"></p>

          <div class="d-grid gap-3">
            <% quickLinks.forEach(function(link) { %>
              <% const quickFilterText = [link.title, link.description, link.action].join(' ').toLowerCase(); %>
              <a class="text-decoration-none" href="<%= link.href %>" data-quick-link="true" data-filter-text="<%= quickFilterText %>">
                <div class="border rounded-4 p-3 bg-body-tertiary quick-link-card" role="group" aria-label="<%= link.title %>">
                  <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                      <h3 class="h6 mb-1 text-dark"><%= link.title %></h3>
                      <p class="text-secondary mb-0"><%= link.description %></p>
                    </div>
                    <span class="badge text-bg-light border text-dark"><%= link.action %></span>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
          <div id="quickLinkEmptyState" class="alert alert-light border mt-3 d-none mb-0" role="status" aria-live="polite">
            Không tìm thấy chức năng phù hợp với từ khóa. Hãy thử từ khác.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const input = document.getElementById('quickLinkSearchInput');
    const summary = document.getElementById('quickLinkSearchSummary');
    const countBadge = document.getElementById('quickLinkCountBadge');
    const emptyState = document.getElementById('quickLinkEmptyState');
    const links = Array.from(document.querySelectorAll('a[data-quick-link="true"]'));

    if (!input || !summary || !countBadge || !emptyState || !links.length) {
      return;
    }

    let debounceTimer = null;

    function renderSummary(visibleCount, totalCount) {
      if (visibleCount === totalCount) {
        summary.textContent = `Hiển thị toàn bộ ${totalCount} chức năng.`;
      } else {
        summary.textContent = `Hiển thị ${visibleCount}/${totalCount} chức năng theo từ khóa.`;
      }

      countBadge.textContent = `${visibleCount} mục`;
      emptyState.classList.toggle('d-none', visibleCount !== 0);
    }

    function applyFilter() {
      const keyword = (input.value || '').trim().toLowerCase();
      let visibleCount = 0;

      links.forEach(function(link) {
        const text = (link.getAttribute('data-filter-text') || '').toLowerCase();
        const show = !keyword || text.includes(keyword);

        link.classList.toggle('d-none', !show);

        if (show) {
          visibleCount += 1;
        }
      });

      renderSummary(visibleCount, links.length);
    }

    function scheduleFilter() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilter, 180);
    }

    input.addEventListener('input', scheduleFilter);
    applyFilter();
  })();
</script>

<%- include('partials/footer') %>
