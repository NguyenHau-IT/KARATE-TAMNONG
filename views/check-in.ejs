<%- include('partials/header', { title, activePage: 'check-in' }) %>

<div class="container">
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-secondary small fw-semibold mb-1">Karate Tamnong</p>
      <h1 class="h2 mb-2">Điểm danh võ sinh</h1>
      <p class="text-secondary mb-0">Võ sinh điểm danh bằng QR token do HLV mở từ màn hình buổi học.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/check-in">Làm mới</a>
  </div>

  <% if (message) { %>
    <div class="alert alert-success" role="status" aria-live="polite"><%= message %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert" aria-live="assertive"><%= errorMessage %></div>
  <% } %>
  <% if (!token) { %>
    <div class="alert alert-info" role="status" aria-live="polite">
      Check-in bằng PIN đã ngừng hỗ trợ. Vui lòng quét mã QR từ tab điểm danh trực tiếp.
    </div>
  <% } %>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
      <div>
        <p class="small text-secondary mb-1">Trạng thái QR token</p>
        <% if (token && tokenValid) { %>
          <p class="mb-0 text-success fw-semibold">Hợp lệ — có thể điểm danh ngay.</p>
        <% } else if (token && !tokenValid) { %>
          <p class="mb-0 text-danger fw-semibold">Token không hợp lệ hoặc đã hết hạn.</p>
        <% } else { %>
          <p class="mb-0 text-warning fw-semibold">Chưa có token. Vui lòng quét QR để tiếp tục.</p>
        <% } %>
      </div>

      <% if (token && tokenValid && tokenExpiresAt) { %>
        <div class="text-lg-end">
          <p class="small text-secondary mb-1">Hết hạn lúc</p>
          <p class="mb-0 fw-semibold"><%= new Date(tokenExpiresAt).toLocaleTimeString('vi-VN') %></p>
          <p id="tokenCountdown" class="small text-secondary mb-0">--:--</p>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <form method="get" action="/check-in" class="row g-3 align-items-end">
        <div class="col-lg-8">
          <label class="form-label" for="buoi_hoc_id">Chọn buổi học</label>
          <select class="form-select" id="buoi_hoc_id" name="buoi_hoc_id">
            <option value="">Chọn buổi học</option>
            <% buoiHocList.forEach(function(item) { %>
              <option value="<%= item.id %>" <%= selectedBuoiHocId === item.id ? 'selected' : '' %>>
                #<%= item.id %> - <%= item.lop_vo ? item.lop_vo.ten_lop : ('Lớp #' + item.lop_vo_id) %> - <%= item.ngay_hoc %>
                (<%= item.gio_bat_dau || '--:--' %> - <%= item.gio_ket_thuc || '--:--' %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-4 d-grid">
          <button class="btn btn-primary" type="submit" data-loading-text="Đang tải danh sách...">Tải danh sách võ sinh</button>
        </div>
      </form>
    </div>
  </div>

  <% if (selectedBuoiHoc) { %>
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Xác nhận điểm danh</h2>
            <div class="mb-3 text-secondary small">
              Buổi: <strong>#<%= selectedBuoiHoc.id %></strong> —
              <strong><%= selectedBuoiHoc.lop_vo ? selectedBuoiHoc.lop_vo.ten_lop : ('Lớp #' + selectedBuoiHoc.lop_vo_id) %></strong>
              (<%= selectedBuoiHoc.ngay_hoc %>, <%= selectedBuoiHoc.gio_bat_dau || '--:--' %> - <%= selectedBuoiHoc.gio_ket_thuc || '--:--' %>)
            </div>

            <% if (!voSinhOptions || !voSinhOptions.length) { %>
              <div class="alert alert-warning" role="alert" aria-live="polite">
                Buổi học này hiện chưa có võ sinh khả dụng cho tài khoản của bạn. Vui lòng liên hệ HLV/Admin để kiểm tra danh sách lớp.
              </div>
            <% } %>

            <form method="post" action="/check-in" class="vstack gap-3">
              <input type="hidden" name="token" value="<%= token || '' %>" />

              <div>
                <label class="form-label" for="vo_sinh_id">Võ sinh</label>
                <% if (forceVoSinhId) { %>
                  <% const selfOption = voSinhOptions && voSinhOptions.length ? voSinhOptions[0] : null; %>
                  <input type="hidden" name="vo_sinh_id" value="<%= forceVoSinhId %>" />
                  <input
                    class="form-control"
                    value="<%= selfOption ? (selfOption.ho_ten || ('Võ sinh #' + selfOption.vo_sinh_id)) : ('Võ sinh #' + forceVoSinhId) %>"
                    disabled
                  />
                <% } else { %>
                  <select class="form-select" id="vo_sinh_id" name="vo_sinh_id" required>
                    <option value="">Chọn võ sinh</option>
                    <% voSinhOptions.forEach(function(item) { %>
                      <option value="<%= item.vo_sinh_id %>"><%= item.ho_ten || ('Võ sinh #' + item.vo_sinh_id) %> (#<%= item.vo_sinh_id %>)</option>
                    <% }) %>
                  </select>
                <% } %>
              </div>

              <button class="btn btn-success" type="submit" aria-label="Xác nhận điểm danh võ sinh" data-loading-text="Đang điểm danh..." <%= !token || !tokenValid || !voSinhOptions || !voSinhOptions.length ? 'disabled' : '' %>>Điểm danh</button>
              <% if (!token || !tokenValid || !voSinhOptions || !voSinhOptions.length) { %>
                <p class="small text-secondary mb-0">Cần QR token hợp lệ và võ sinh khả dụng trước khi xác nhận điểm danh.</p>
              <% } %>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Cách dùng</h2>
            <ol class="mb-0 text-secondary">
              <li>Quét QR trên tab điểm danh trực tiếp để vào đúng buổi học.</li>
              <li>Hệ thống xác thực token tự động và ghi nhận điểm danh.</li>
              <li>Nếu token hết hạn, nhờ HLV mở lại phiên điểm danh mới.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<% if (token && tokenValid && tokenExpiresAt) { %>
  <script>
    (function() {
      const countdownEl = document.getElementById('tokenCountdown');

      if (!countdownEl) {
        return;
      }

      const expiresAtMs = new Date('<%= tokenExpiresAt %>').getTime();

      function renderCountdown() {
        const distance = expiresAtMs - Date.now();

        if (distance <= 0) {
          countdownEl.textContent = 'Token đã hết hạn';
          return false;
        }

        const totalSec = Math.floor(distance / 1000);
        const min = String(Math.floor(totalSec / 60)).padStart(2, '0');
        const sec = String(totalSec % 60).padStart(2, '0');
        countdownEl.textContent = `Còn ${min}:${sec}`;
        return true;
      }

      if (!renderCountdown()) {
        return;
      }

      const timer = setInterval(function() {
        if (!renderCountdown()) {
          clearInterval(timer);
        }
      }, 1000);
    })();
  </script>
<% } %>

<%- include('partials/footer') %>
