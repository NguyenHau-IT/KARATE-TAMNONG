<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="bg-body-tertiary d-flex align-items-center" style="min-height: 100vh;">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm border-0">
            <div class="card-body p-4">
              <h1 class="h4 mb-3 text-center">Đăng nhập Karate Tamnong</h1>

              <% if (message) { %>
                <div class="alert alert-success"><%= message %></div>
              <% } %>

              <% if (errorMessage) { %>
                <div class="alert alert-danger"><%= errorMessage %></div>
              <% } %>

              <form method="post" action="/auth/login" class="vstack gap-3">
                <input type="hidden" name="next" value="<%= nextPath || '' %>" />

                <div>
                  <label class="form-label" for="username">Tên đăng nhập</label>
                  <input id="username" name="username" class="form-control" required />
                </div>

                <div>
                  <label class="form-label" for="password">Mật khẩu</label>
                  <input id="password" name="password" type="password" class="form-control" required />
                </div>

                <button class="btn btn-primary" type="submit">Đăng nhập</button>
              </form>

              <div class="small text-secondary mt-3">
                Nếu chưa có tài khoản, vui lòng liên hệ quản trị viên.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
