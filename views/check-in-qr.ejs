<%- include('partials/header', { title, activePage: 'check-in-qr' }) %>

<div class="container">
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-secondary small fw-semibold mb-1">Karate Tamnong</p>
      <h1 class="h2 mb-2">Check-in bằng QR</h1>
      <p class="text-secondary mb-0">Quét mã QR theo buổi học để điểm danh có mặt.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/check-in-qr">Làm mới</a>
  </div>

  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger"><%= errorMessage %></div>
  <% } %>

  <% if (!token) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h2 class="h5 mb-3">Nhập link QR hoặc chọn buổi học</h2>
        <form method="get" action="/check-in-qr" class="row g-3 align-items-end">
          <div class="col-lg-8">
            <label class="form-label" for="buoi_hoc_id">Buổi học</label>
            <select class="form-select" id="buoi_hoc_id" name="buoi_hoc_id" required>
              <option value="">Chọn buổi học</option>
              <% buoiHocList.forEach(function(item) { %>
                <option value="<%= item.id %>" <%= selectedBuoiHocId === item.id ? 'selected' : '' %>>
                  #<%= item.id %> - <%= item.lop_vo ? item.lop_vo.ten_lop : ('Lớp #' + item.lop_vo_id) %> - <%= item.ngay_hoc %>
                  (<%= item.gio_bat_dau || '--:--' %> - <%= item.gio_ket_thuc || '--:--' %>)
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-lg-4 d-grid">
            <button class="btn btn-primary" type="submit">Tải danh sách võ sinh</button>
          </div>
        </form>
        <p class="text-secondary small mt-3 mb-0">Gợi ý: mở QR từ tab Buổi học để tự động kèm token.</p>
      </div>
    </div>
  <% } %>

  <% if (selectedBuoiHoc) { %>
    <div class="row g-4 mt-1">
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Xác nhận check-in</h2>
            <div class="mb-3 text-secondary small">
              Buổi: <strong>#<%= selectedBuoiHoc.id %></strong> —
              <strong><%= selectedBuoiHoc.lop_vo ? selectedBuoiHoc.lop_vo.ten_lop : ('Lớp #' + selectedBuoiHoc.lop_vo_id) %></strong>
              (<%= selectedBuoiHoc.ngay_hoc %>, <%= selectedBuoiHoc.gio_bat_dau || '--:--' %> - <%= selectedBuoiHoc.gio_ket_thuc || '--:--' %>)
            </div>

            <% if (token && !tokenValid) { %>
              <div class="alert alert-warning">Token QR không còn hiệu lực. Vui lòng tạo lại QR mới.</div>
            <% } %>

            <form method="post" action="/check-in-qr" class="vstack gap-3">
              <input type="hidden" name="token" value="<%= token || '' %>" />

              <div>
                <label class="form-label" for="vo_sinh_id">Võ sinh</label>
                <% if (forceVoSinhId) { %>
                  <% const selfOption = voSinhOptions && voSinhOptions.length ? voSinhOptions[0] : null; %>
                  <input type="hidden" name="vo_sinh_id" value="<%= forceVoSinhId %>" />
                  <input
                    class="form-control"
                    value="<%= selfOption ? (selfOption.ho_ten || ('Võ sinh #' + selfOption.vo_sinh_id)) : ('Võ sinh #' + forceVoSinhId) %>"
                    disabled
                  />
                <% } else { %>
                  <select class="form-select" id="vo_sinh_id" name="vo_sinh_id" required>
                    <option value="">Chọn võ sinh</option>
                    <% voSinhOptions.forEach(function(item) { %>
                      <option value="<%= item.vo_sinh_id %>"><%= item.ho_ten || ('Võ sinh #' + item.vo_sinh_id) %> (#<%= item.vo_sinh_id %>)</option>
                    <% }) %>
                  </select>
                <% } %>
              </div>

              <button class="btn btn-success" type="submit" <%= token && !tokenValid ? 'disabled' : '' %>>Check-in bằng QR</button>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Lưu ý sử dụng QR</h2>
            <ol class="mb-0 text-secondary">
              <li>HLV tạo QR tại màn hình Buổi học.</li>
              <li>QR chỉ có hiệu lực trong thời gian ngắn (TTL).</li>
              <li>Mỗi lần tạo mới sẽ thay thế token cũ.</li>
              <li>Võ sinh không thuộc lớp sẽ bị từ chối check-in.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
